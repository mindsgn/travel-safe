# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app bundle,
# so never put secrets here (provider API keys belong in backend/code/.env).

# Travel Safe API base URL. Must be HTTPS in production.
# Leave empty in development to use http://127.0.0.1:8000 (http://10.0.2.2:8000 on the Android emulator).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Local reminder offsets before the deadline, in hours: "<reminder>,<final warning>".
# Each is capped relative to the interval (25% / 10%) so short intervals still make sense.
EXPO_PUBLIC_REMINDER_OFFSETS_HOURS=24,2

# Set to "production" for store builds (disables cleartext HTTP on Android).
APP_ENV=development
