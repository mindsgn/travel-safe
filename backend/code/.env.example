# Copy to .env (git-ignored) and load it before starting the API or worker:
#   set -a; source .env; set +a
# Never commit real values.

# --- Core ---
DEADMAN_DB_PATH=travel.db
# Public HTTPS origin of this API. Used for emergency links (/e/<token>).
DEADMAN_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed by CORS. The mobile app does not need CORS.
DEADMAN_CORS_ORIGINS=*

# --- Retention and worker ---
DEADMAN_LOCATION_RETENTION_HOURS=24
DEADMAN_EMERGENCY_LINK_TTL_DAYS=30
DEADMAN_ARCHIVE_RETENTION_DAYS=90
DEADMAN_NOTIFICATION_MAX_ATTEMPTS=3
DEADMAN_WORKER_INTERVAL_SECONDS=60

# --- Email (Resend) ---
# Without these, email notifications are recorded as failed with reason channel_not_configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Travel Safe <alerts@example.com>

# --- WhatsApp (whatsapp-bot gateway) ---
# URL of the whatsapp-bot HTTP gateway (POST /send). Leave empty to disable phone notifications.
WHATSAPP_BOT_URL=
# Optional shared secret sent to the gateway (the bot must be configured to check it).
WHATSAPP_BOT_TOKEN=

# --- Mapbox ---
# Public (pk.) token used by the emergency page map. Restrict it to your domain in the Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=
# Secret server token used for reverse geocoding (addresses). Optional.
MAPBOX_SERVER_TOKEN=
